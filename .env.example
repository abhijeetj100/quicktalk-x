# Copy this file to .env and fill in the values before running docker-compose
# .env is gitignored and should never be committed

# PostgreSQL
POSTGRES_PASSWORD=changeme-pg-password

# JWT signing secret (required in production)
JWT_SECRET=changeme-jwt-secret

# Allowed CORS origin for API and WebSocket servers
CORS_ORIGIN=http://localhost

# Vite build-time API URLs (baked into the frontend build)
VITE_API_URL=http://localhost/api
VITE_WS_URL=ws://localhost/socket.io
